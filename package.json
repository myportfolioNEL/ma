{
  "name": "noureddine-el-mobaraki-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio of Noureddine El Mobaraki — front-end engineer, Casablanca.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/audit-css-vars.mjs && node scripts/audit-assets.mjs && node scripts/audit-cv.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:css": "node scripts/audit-css-vars.mjs",
    "audit:cv": "node scripts/audit-cv.mjs",
    "cv:restore": "node scripts/restore-cv.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
